# Treino do Joelho — servidor Express (única porta de entrada do banco)
# Copie para server/.env e preencha. server/.env está no .gitignore.

# Rede: só loopback (o Spotify exige 127.0.0.1 no redirect; localhost não é aceito)
HOST=127.0.0.1
PORT=3001

# Supabase — projeto daniel-health-app (sa-east-1)
SUPABASE_URL=https://qktebgvnejjhpfdriert.supabase.co
# Chave SECRETA (service_role). Nunca vai para o client, nunca é logada.
SUPABASE_SERVICE_ROLE_KEY=

# Dono único (mesmo UUID fixo do health app)
OWNER_ID=00000000-0000-0000-0000-000000000001

# Spotify (cards 5.x) — Authorization Code + PKCE, sem client secret
SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/api/spotify/callback

# Chave do aparelho (Authorization: Bearer). Mínimo 32 caracteres aleatórios. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
DEVICE_TOKEN=
